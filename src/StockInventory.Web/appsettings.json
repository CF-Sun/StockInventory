{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Limits": { "MaxPortfoliosPerUser": 20, "MaxHoldingsPerPortfolio": 200 },
  "Quote": {
    "Enabled": true,
    "BatchSize": 30,
    "MaxRequestsPer5s": 3,
    "ActiveIntervalSeconds": 5,
    "IdleIntervalSeconds": 300,
    "TimeoutSeconds": 5,
    "StaleSeconds": 180
  },
  "Market": { "OpenTime": "08:30", "CloseTime": "14:35", "TimeZoneId": "Taipei Standard Time" },
  "Fees": { "MinFee": 20, "StockTaxRate": 0.003, "EtfTaxRate": 0.001 },
  "Auth": { "IdleMinutes": 30, "TrustDeviceDays": 30, "LockoutMaxFailures": 5, "LockoutMinutes": 15, "MinPasswordLength": 12 },
  "Alert": { "CooldownMinutes": 30, "LoginFailThreshold": 10, "LoginFailWindowMinutes": 10 }
}
