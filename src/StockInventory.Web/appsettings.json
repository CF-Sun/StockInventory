{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Vision": { "Endpoint": "https://api.anthropic.com/v1/messages", "Model": "claude-sonnet-5-5", "TimeoutSeconds": 30, "MaxImageBytes": 5242880, "MaxCallsPerUserPerHour": 10, "MaxCallsPerDay": 200 },
  "Limits": { "MaxPortfoliosPerUser": 20, "MaxHoldingsPerPortfolio": 200 },
  "Quote": {
    "Enabled": true,
    "BatchSize": 30,
    "MaxRequestsPer5s": 3,
    "ActiveIntervalSeconds": 5,
    "UnwatchedIntervalSeconds": 30,
    "IdleIntervalSeconds": 300,
    "TimeoutSeconds": 5,
    "StaleSeconds": 180
  },
  "Intraday": { "Enabled": true, "RecordStartTime": "09:00", "RecordEndTime": "13:30", "RetentionDays": 7, "FlushSeconds": 60, "MaxPoints": 90, "GapBreakSeconds": 180, "MaxRequestsPerMinute": 30 },
  "Market": { "OpenTime": "08:30", "CloseTime": "14:35", "TimeZoneId": "Taipei Standard Time" },
  "Fees": { "MinFee": 20, "StockTaxRate": 0.003, "EtfTaxRate": 0.001 },
  "Auth": { "IdleMinutes": 30, "TrustDeviceDays": 30, "LockoutMaxFailures": 5, "LockoutMinutes": 15, "MinPasswordLength": 12 },
  "Alert": { "CooldownMinutes": 30, "LoginFailThreshold": 10, "LoginFailWindowMinutes": 10 }
}
