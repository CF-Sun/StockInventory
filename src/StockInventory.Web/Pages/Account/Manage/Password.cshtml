@page
@model StockInventory.Web.Pages.Account.Manage.PasswordModel
@{ ViewData["Title"] = "變更密碼"; }
<h1>變更密碼</h1>
@if (Model.MustChange) { <p>首次登入或密碼已被重設,請先變更密碼。</p> }
<form method="post" class="card">
  @if (Model.Errors.Count > 0) { <div class="err" role="alert">@foreach (var e in Model.Errors) { <div>@e</div> }</div> }
  <label asp-for="CurrentPassword">目前密碼</label>
  <input asp-for="CurrentPassword" type="password" autocomplete="current-password" />
  <label asp-for="NewPassword">新密碼(至少 @Model.MinLength 字元)</label>
  <input asp-for="NewPassword" type="password" autocomplete="new-password" />
  <label asp-for="ConfirmPassword">確認新密碼</label>
  <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
  <button type="submit">變更密碼</button>
</form>
