@page
@model StockInventory.Web.Pages.Account.LoginWith2faModel
@{ ViewData["Title"] = "雙重驗證"; }
<h1>雙重驗證</h1>
<form method="post" class="card">
  <input type="hidden" asp-for="ReturnUrl" />
  @if (Model.Error is not null) { <div class="err" role="alert">@Model.Error</div> }
  <label asp-for="Code">驗證器 6 位數代碼</label>
  <input asp-for="Code" type="text" inputmode="numeric" autocomplete="one-time-code" autofocus />
  <div class="check"><input asp-for="RememberDevice" type="checkbox" /><label asp-for="RememberDevice">信任此裝置 30 天</label></div>
  <button type="submit">驗證</button>
  <p><a asp-page="LoginWithRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl">手機遺失?使用還原碼登入</a></p>
</form>
