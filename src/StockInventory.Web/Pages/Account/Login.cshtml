@page
@model StockInventory.Web.Pages.Account.LoginModel
@{ ViewData["Title"] = "登入"; }
<h1>登入</h1>
<form method="post" class="card">
  <input type="hidden" asp-for="ReturnUrl" />
  @if (Model.Error is not null) { <div class="err" role="alert">@Model.Error</div> }
  <label asp-for="UserName">帳號</label>
  <input asp-for="UserName" type="text" autocomplete="username" autofocus />
  <label asp-for="Password">密碼</label>
  <input asp-for="Password" type="password" autocomplete="current-password" />
  <button type="submit">登入</button>
</form>
